# Dockerfile.metaextractor - BookExtractor FastAPI service with GPU support
FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3-pip curl \
    && rm -rf /var/lib/apt/lists/* \
    && curl -LsSf https://astral.sh/uv/install.sh | sh

ENV PATH="/root/.local/bin:${PATH}"
ENV HF_HOME=/root/.cache/huggingface/hub

RUN uv pip install --system vllm>=0.8.0

COPY pyproject.toml uv.lock* ./
# Install dependencies first (caches this heavy layer)
RUN uv pip install --system --no-install-project .

# Now copy the frequently-changing source code
COPY metaextractor/ ./metaextractor/

# Install the project itself
RUN uv pip install --system --no-deps -e .

EXPOSE 8000
CMD ["uvicorn", "metaextractor.main:app", "--host", "0.0.0.0", "--port", "8000"]
