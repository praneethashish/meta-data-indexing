# --- vParse OCR Configuration ---
# The URL of the mineru-dots (vParse) API service
VPARSE_API_URL=http://localhost:8000/file_parse

# --- vLLM / LLM Model Configuration ---
# HuggingFace model ID to use (e.g., Qwen/Qwen2.5-VL-7B-Instruct, google/gemma-4-E4B-it)
VLLM_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct

# Number of GPUs for tensor parallelism (Auto-detected if not set)
# VLLM_TENSOR_PARALLEL_SIZE=1

# Hardware & Optimization Overrides (Optional)
# VLLM_DEVICE=cuda              # Options: cuda, tpu, mps, cpu
# VLLM_DTYPE=bfloat16           # Options: bfloat16, float16, float32
# VLLM_GPU_MEMORY_UTILIZATION=0.85

# --- Celery / Redis Configuration ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Server Configuration ---
# PORT=8000
# HOST=0.0.0.0

# --- Upload Directory ---
BOOKEXTRACTOR_UPLOAD_DIR=uploads

# --- Hardware & LLM Limits ---
# Max context window for vLLM (Use 4096 for local GPUs, 16384+ for A100/L40S)
VLLM_MAX_MODEL_LEN=16384

# GPU Memory Utilization (0.50 for shared dev environments, 0.90 for dedicated inference nodes)
VLLM_GPU_MEMORY_UTILIZATION=0.90

# OCR Truncation Limits (How many characters to feed the LLM)
MAX_BOOK_TEXT_CHARS=60000
MAX_MAGAZINE_TEXT_CHARS=15000
