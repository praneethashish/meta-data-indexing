# --- vParse OCR Configuration ---
# The URL of the mineru-dots (vParse) API service
VPARSE_API_URL=http://localhost:8000/file_parse

# --- Remote LLM (anyLLM) Configuration (Optional) ---
# If these are set, BookExtractor uses anyLLM for remote API inference.
# The configured endpoint may be local/self-hosted or cloud-hosted.
# If they are not set, BookExtractor falls back to the local vLLM model.
#
# Example cloud endpoint (OpenAI-compatible):
# METAEXTRACTOR_LLM_MODEL=gpt-4o-mini
# METAEXTRACTOR_LLM_BASE_URL=https://api.openai.com/v1
# METAEXTRACTOR_LLM_API_KEY=your-api-key
#
# Example self-hosted endpoint:
# METAEXTRACTOR_LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# METAEXTRACTOR_LLM_BASE_URL=http://your-llm-host:8000/v1
# METAEXTRACTOR_LLM_API_KEY=your-api-key
#
# Example Ollama (local):
METAEXTRACTOR_LLM_MODEL=qwen2.5:7b
METAEXTRACTOR_LLM_BASE_URL=http://localhost:11434/v1
METAEXTRACTOR_LLM_API_KEY=ollama
#
# Optional provider override. Defaults to "openai".
# METAEXTRACTOR_LLM_PROVIDER=openai

# --- Local vLLM Model Configuration ---
# Used as fallback when METAEXTRACTOR_LLM_* vars are not set.
# HuggingFace model ID to use (e.g., Qwen/Qwen2.5-VL-7B-Instruct, google/gemma-4-E4B-it)
VLLM_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct

# Number of GPUs for tensor parallelism (Auto-detected if not set)
# VLLM_TENSOR_PARALLEL_SIZE=1

# Hardware & Optimization Overrides (Optional)
# VLLM_DEVICE=cuda              # Options: cuda, tpu, mps, cpu
# VLLM_DTYPE=bfloat16           # Options: bfloat16, float16, float32
# VLLM_GPU_MEMORY_UTILIZATION=0.85

# --- Celery / Redis Configuration ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Server Configuration ---
# PORT=8000
# HOST=0.0.0.0

# --- Upload Directory ---
METAEXTRACTOR_UPLOAD_DIR=uploads
