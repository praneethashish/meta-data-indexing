# --- vParse OCR Configuration ---
# The URL of the mineru-dots (vParse) API service
VPARSE_API_URL=http://localhost:8000/file_parse

# --- vLLM / LLM Model Configuration ---
# HuggingFace model ID for Gemma-4 via vLLM
VLLM_MODEL=google/gemma-4-E4B-it

# HuggingFace access token (required for gated models)
# Obtain from https://huggingface.co/settings/tokens
HF_TOKEN=

# Number of GPUs for tensor parallelism
VLLM_TENSOR_PARALLEL_SIZE=1

# --- Server Configuration ---
# PORT=8000
# HOST=0.0.0.0
