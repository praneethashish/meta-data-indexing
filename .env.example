# --- vParse OCR Configuration ---
# The URL of the mineru-dots (vParse) API service
VPARSE_API_URL=http://localhost:8000/file_parse

# --- vLLM / LLM Model Configuration ---
# Local path used by the runtime container after prefetching into the Docker volume
VLLM_MODEL=/models/vllm/google/gemma-4-E4B-it

# HuggingFace model ID used by the model-downloader container
VLLM_MODEL_ID=google/gemma-4-E4B-it

# Number of GPUs for tensor parallelism
VLLM_TENSOR_PARALLEL_SIZE=1

# --- Server Configuration ---
# PORT=8000
# HOST=0.0.0.0
