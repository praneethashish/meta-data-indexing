# Dockerfile.vparse – Pipeline/Paddle backend (default, CPU-only)
#
# Installs: .[pipeline,api] — includes torch (CPU), torchvision, onnxruntime
# for the full multi-model pipeline OCR. No CUDA/GPU libraries.
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git curl build-essential libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency resolution
RUN pip install --no-cache-dir uv

# Install CPU-only torch first to avoid pulling ~3GB of CUDA libraries
RUN uv pip install --system \
    torch torchvision \
    --index-url https://download.pytorch.org/whl/cpu

# Install VParse pipeline+api (torch already satisfied with CPU build)
RUN git clone https://github.com/suryamanoj4/mineru-dots.git /app/mineru-dots && \
    cd /app/mineru-dots && \
    uv pip install --system -e ".[pipeline,api]"

EXPOSE 8000
CMD ["vparse-api", "--host", "0.0.0.0", "--port", "8000"]
