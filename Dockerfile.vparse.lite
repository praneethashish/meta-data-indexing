# Dockerfile.vparse.lite – Lite/Tesseract backend (CPU-only, smallest image)
#
# Installs: .[lite,api] — lightweight, Tesseract-only OCR.
# No torch/torchvision at all.
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git curl build-essential tesseract-ocr && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

RUN git clone https://github.com/suryamanoj4/mineru-dots.git /app/mineru-dots && \
    cd /app/mineru-dots && \
    uv pip install --system -e ".[lite,api]"

EXPOSE 8000
CMD ["vparse-api", "--host", "0.0.0.0", "--port", "8000"]
