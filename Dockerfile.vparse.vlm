# Dockerfile.vparse.vlm – VLM backend (CPU-only by default)
#
# Installs: .[vlm,api] — vision-language model stack.
# Best with GPU. Includes torch, transformers, accelerate.
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git curl build-essential libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

# CPU-only torch first
RUN uv pip install --system \
    torch torchvision \
    --index-url https://download.pytorch.org/whl/cpu

RUN git clone https://github.com/suryamanoj4/mineru-dots.git /app/mineru-dots && \
    cd /app/mineru-dots && \
    uv pip install --system -e ".[vlm,api]"

EXPOSE 8000
CMD ["vparse-api", "--host", "0.0.0.0", "--port", "8000"]
